---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Writing"
  description="Essays and notes from Travis Lima on ecommerce, WooCommerce, customer success, remote work, and building a career on the open web."
>
  <div class="mx-auto w-full max-w-3xl px-5">
    <section class="pt-16 pb-10 sm:pt-24">
      <p class="label">Notes from the field</p>
      <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight">Writing</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted">
        Notes on ecommerce, customer success, remote work, and the open web, from someone who works
        with WooCommerce&rsquo;s largest merchants and built a career from an unlikely starting point.
      </p>
    </section>

    <section class="pb-14">
      <ul class="space-y-5">
        {
          posts.map((post) => (
            <li>
              <a
                href={`/writing/${post.id}/`}
                class="group block rounded-xl border border-line bg-surface-raised p-6 transition-all hover:border-accent hover:shadow-[0_0_32px_var(--accent-glow)]"
              >
                <time datetime={post.data.pubDate.toISOString()} class="label">
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <h2 class="mt-2 font-display text-2xl font-semibold transition-colors group-hover:text-accent-strong">
                  {post.data.title}
                </h2>
                <p class="mt-2 max-w-2xl leading-relaxed text-ink-muted">{post.data.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
