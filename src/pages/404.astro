---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <section class="relative mx-auto w-full max-w-3xl overflow-hidden px-5 pt-28 pb-14 text-center">
    <div class="wash absolute inset-x-0 top-0 h-64" aria-hidden="true"></div>
    <p class="label relative">404 · Inspection failed</p>
    <h1 class="relative mt-4 text-4xl font-bold tracking-tighter">This page doesn&rsquo;t exist.</h1>
    <p class="relative mt-4 text-ink-muted">Like a store without products: nothing to see here.</p>
    <a
      href="/"
      class="relative mt-10 inline-block rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors duration-300 hover:bg-accent-strong"
    >
      Back to the story
    </a>
  </section>
</BaseLayout>
