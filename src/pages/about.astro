---
import BaseLayout from '../layouts/BaseLayout.astro';

const timeline = [
  {
    period: 'Before 2013',
    title: 'Welding & Coating Inspector, South Africa',
    body: 'Qualified Level 2 inspector, South African Institute of Welding. Learned to look closely, ask why, and never sign off on unverified work.',
  },
  {
    period: '2013',
    title: 'Found WordPress',
    body: 'Built a first site, taught myself design and development, freelanced as Travis Lima Design.',
  },
  {
    period: '2016 – 2021',
    title: 'Paid Memberships Pro',
    body: 'Support engineer, content creator, webinar host. Ran the PMPro YouTube channel and helped thousands of people build membership businesses. Worked remotely from all over the world and started The Howzit Podcast.',
  },
  {
    period: '2021 – today',
    title: 'WooCommerce',
    body: 'Senior customer success leader. Consults with merchants doing $1M+ a year, and helped grow the sales & customer success team from zero into a meaningful part of Woo’s revenue. Spoke at WordCamp Europe and WordCamp US 2024.',
  },
];
---

<BaseLayout
  title="About"
  description="The facts about Travis Lima: welding inspector turned WooCommerce customer success leader, WordCamp speaker, a decade in WordPress."
>
  <div class="mx-auto w-full max-w-3xl px-5">
    <section class="pt-16 pb-10 sm:pt-24">
      <p class="label">The facts, for people in a hurry</p>
      <div class="mt-5 flex items-center gap-6">
        <img
          src="/images/travis.jpg"
          alt="Travis Lima"
          width="460"
          height="460"
          class="duotone h-20 w-20 rounded-full border border-line object-cover sm:h-28 sm:w-28"
        />
        <h1 class="font-display text-4xl font-semibold tracking-tight">About</h1>
      </div>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted">
        The <a href="/" class="text-accent-strong underline underline-offset-3 hover:text-ink">full story lives on the homepage</a>.
        This page is the short version: who I am, what I&rsquo;ve done, and where I&rsquo;ve done it.
      </p>
    </section>

    <section class="pb-14" aria-label="Career timeline">
      <ol class="relative space-y-12 border-l border-line pl-10">
        {
          timeline.map((item) => (
            <li class="relative">
              <span
                class="absolute -left-[45px] top-1 h-2.5 w-2.5 rounded-full bg-accent shadow-[0_0_10px_var(--accent-glow)]"
                aria-hidden="true"
              />
              <p class="label">{item.period}</p>
              <h2 class="mt-2 font-display text-xl font-semibold">{item.title}</h2>
              <p class="mt-2 max-w-2xl leading-relaxed text-ink-muted">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="border-t border-line py-14">
      <h2 class="font-display text-2xl font-semibold">Off the clock</h2>
      <p class="mt-4 max-w-2xl leading-relaxed text-ink-muted">
        South African, now based in San Francisco, with digital-nomad years in between. I build side
        projects on
        <a href="https://github.com/travislima" class="text-accent-strong underline underline-offset-3 hover:text-ink">GitHub</a>,
        I&rsquo;ve hosted
        <a href="https://travislima.blog/" class="text-accent-strong underline underline-offset-3 hover:text-ink">The Howzit Podcast</a>,
        and I write about ecommerce, remote work, and building a career on the open web.
      </p>
      <p class="mt-4 max-w-2xl leading-relaxed text-ink-muted">
        If any of that resonates, <a href="/contact/" class="text-accent-strong underline underline-offset-3 hover:text-ink">say hi</a>.
        I answer.
      </p>
    </section>
  </div>
</BaseLayout>
