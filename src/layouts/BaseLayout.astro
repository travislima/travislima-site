---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, NAV_LINKS, SOCIAL, EMAIL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
}

const { title, description = SITE_DESCRIPTION, ogType = 'website' } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · Ecommerce, WooCommerce & Customer Success`;
const canonical = new URL(Astro.url.pathname, SITE_URL);
const currentPath = Astro.url.pathname;

const ogImage = new URL('/images/travis.jpg', SITE_URL);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Travis Lima',
  url: SITE_URL,
  image: ogImage.toString(),
  jobTitle: 'Customer Success Senior Manager',
  worksFor: {
    '@type': 'Organization',
    name: 'WooCommerce',
    url: 'https://woocommerce.com',
  },
  description: SITE_DESCRIPTION,
  sameAs: [SOCIAL.github, SOCIAL.x, SOCIAL.linkedin, SOCIAL.wordpress, SOCIAL.instagram],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07080a" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@travislima" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script>
      document.documentElement.classList.add('js');
      const reveal = () => {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15 }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', reveal);
      } else {
        reveal();
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 border-b border-line bg-black/70 backdrop-blur-xl">
      <div class="mx-auto flex w-full max-w-5xl items-center justify-between px-5 py-3">
        <a
          href="/"
          class="text-sm font-semibold tracking-tight transition-colors duration-300 hover:text-accent-strong"
        >
          Travis&nbsp;Lima
        </a>
        <nav aria-label="Main">
          <ul class="flex items-center gap-7 text-xs">
            {
              NAV_LINKS.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
                    class:list={[
                      'transition-colors duration-300 hover:text-accent-strong',
                      currentPath.startsWith(link.href) ? 'text-accent-strong font-medium' : 'text-ink-muted',
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main class="flex-1 w-full">
      <slot />
    </main>

    <footer class="border-t border-line mt-24">
      <div class="mx-auto w-full max-w-5xl px-5 py-10 text-xs text-ink-muted">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <a href={SOCIAL.github} class="transition-colors hover:text-accent-strong" rel="me">GitHub</a>
          <a href={SOCIAL.x} class="transition-colors hover:text-accent-strong" rel="me">X</a>
          <a href={SOCIAL.linkedin} class="transition-colors hover:text-accent-strong" rel="me">LinkedIn</a>
          <a href={SOCIAL.wordpress} class="transition-colors hover:text-accent-strong" rel="me">WordPress.org</a>
          <a href={`mailto:${EMAIL}`} class="transition-colors hover:text-accent-strong">Email</a>
          <a href="/rss.xml" class="transition-colors hover:text-accent-strong">RSS</a>
        </div>
        <p class="mt-5">
          &copy; {new Date().getFullYear()} Travis Lima. Views are my own, not my employer&rsquo;s.
        </p>
      </div>
    </footer>
  </body>
</html>
